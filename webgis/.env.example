# BaumRadar WebGIS - Konfiguration (Kopie als .env ablegen)
# Tipp: start.cmd / start.sh legt die .env automatisch an und ERSETZT die
# Passwörter unten durch zufällige Werte. Wer die Datei von Hand kopiert,
# sollte PG_PASSWORD und GEOSERVER_PASSWORD selbst ändern.
# ACHTUNG: Das PostGIS-Passwort gilt ab der ERSTEN Initialisierung des
# Datenbank-Volumes; späteres Ändern erfordert `docker compose down -v`.

PG_DB=baumradar
PG_USER=baumradar
PG_PASSWORD=baumradar
PG_PORT=5433

GEOSERVER_USER=admin
GEOSERVER_PASSWORD=geoserver
GEOSERVER_PORT=8081

# Härtung: Admin-/Datenports (GeoServer, PostGIS, GraphHopper, Photon) sind nur
# auf localhost gebunden. 0.0.0.0 = bewusst im LAN erreichbar machen.
# Der Web-Client (WEB_PORT) ist immer im LAN erreichbar - er ist die Demo und
# reicht nur lesende Dienste same-origin durch.
BIND_HOST=127.0.0.1
# Mindestens 2.27 (ogcapi-features gibt es erst ab dort als stabile Extension)
GEOSERVER_VERSION=2.28.0

# Web-Client (Angular + OpenLayers)
WEB_PORT=8082

# Kommagetrennte Stadt-IDs (leer = alle 19 Städte), z. B.: wien,linz,graz
CITY_FILTER=

# Quelle des signierten Datenbestands
CATALOG_URL=https://raw.githubusercontent.com/matthili/BaumRadar/master/docs/data/catalog.json

# GeoServer-Provisionierung überspringen (true = nur PostGIS-Import)
SKIP_GEOSERVER=false

# Wie viele Städte parallel importiert werden (Virtual Threads, Drossel)
MAX_PARALLEL_IMPORTS=4

# --- Routing (Phase 4, nur mit `docker compose --profile routing up`) ---
# GraphHopper-Release-Tag (GitHub); Port; JVM-Heap; BBox-Puffer je Seite in Grad.
GH_VERSION=10.0
GRAPHHOPPER_PORT=8989
GH_JAVA_OPTS=-Xmx2g -Xms1g
BBOX_MARGIN_DEG=0.03
# Stadt-BBoxen je osmium-Lauf. osmium braucht ~1,5 GB RAM JE Stadt im Batch
# (unabhängig von der Stadtgröße). 1 = sicher ab ~3 GB Docker-VM; wer der
# Docker-VM 8+ GB gibt, kann z. B. 4 setzen (schnellerer Erstlauf).
EXTRACT_BATCH=1

# --- Geocoder / Adresssuche (nur mit `docker compose --profile geocoding up`) ---
# Photon-Release (GitHub) und Port. Importiert die pro-Stadt-Geocoder-Häppchen
# aus dem Katalog (CITY_FILTER gilt auch hier; leer = alle 19 Städte, ~1,2 GB).
PHOTON_VERSION=1.2.1
PHOTON_PORT=2322
# Java-Heap für den EINMALIGEN Index-Import: viele Städte = viel RAM.
# Alle 19 Städte (~18 GB Rohdaten): -Xmx4g bis -Xmx8g. Stürzt der Import ab
# (Overlay/Logs melden es), hier erhöhen und den Photon-Container neu starten.
PHOTON_IMPORT_JAVA_OPTS=-Xmx4g
# Java-Heap für den laufenden Suchdienst (nach dem Import).
PHOTON_JAVA_OPTS=-Xmx1g
