@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Inter
skinparam roundCorner 12

skinparam sequenceGroupHeaderFontColor black
skinparam sequenceDividerFontColor black

skinparam participant {
  BackgroundColor #E3F2FD
  BorderColor #1976D2
  FontColor black
}

actor "Nutzer:in" as U
participant "Angular-Client\n(OpenLayers)" as C
participant "Photon\n(/photon)" as P
participant "GeoServer WFS\n(/geoserver)" as W
participant "GraphHopper\n(/graphhopper)" as G

== Adresssuche (lokal, Stadt-gescopt) ==
U -> C : tippt „Kolinplatz 1…"
C -> P : GET /api?q=…&bbox=<Stadt-BBox>&lang=de
P --> C : GeoJSON-Treffer (Adressen + POIs)
U -> C : wählt Start & Ziel\n(oder Karten-Klick)

== Route mit Allergiezonen-Vermeidung ==
C -> W : GetFeature allergy_zones\nCQL: genus IN (Profil)\nAND BBOX(Korridor,'EPSG:4326')
W --> C : Zonen-Polygone (GeoJSON)
C -> C : bündelt zu EINEM MultiPolygon\n(Custom-Model-Area „avoid")
C -> G : POST /route {points, profile,\ncustom_model: in_avoid ×Faktor\n(wählbar: 5- bis 100-fach meiden)}
G --> C : Route (LineString, Distanz, Zeit)
C -> U : grüne Route + „meidet N Zonen"
@enduml
