@startuml
!theme plain
title Data-Processor Package Structure (19 cities)

package at.mafue.baumradar.dataprocessor {

  class Main {
    - {static} BASE_URL: String
    - {static} PUB_KEY_FILE: String
    + {static} main(String[] args)
  }

  package models {
    class TreeRecord {
      + id: String
      + cityId: String
      + latitude: double
      + longitude: double
      + genusDe: String
      + genusEn: String
      + speciesDe: String
      + speciesEn: String
    }
    class GeofenceRecord {
      + id: String
      + cityId: String
      + latitude: double
      + longitude: double
      + radius: int
      + count: int
      + genusDe: String
    }
  }

  package providers {
    interface CityProvider {
      + getCityId(): String
      + getName(): String
      + getCountry(): String
      + getBoundingBox(): double[]
      + processData(DatabaseExporter exporter)
    }
    abstract class AbstractGeoJsonProvider implements CityProvider {
      # isZipped(): boolean
      # supportsPagination(): boolean
      # getGeoJsonUrl(offset: int): String
      # mapFeatureToTree(feature: JsonNode): TreeRecord
    }
    abstract class AbstractCsvProvider implements CityProvider {
      # getCsvUrl(): String
      # getSplitRegex(): String
      # processHeaders(headers: String[])
      # mapRowToTree(row: String[], lineNumber: long): TreeRecord
    }
    abstract class AbstractXlsxProvider implements CityProvider {
      # getXlsxUrl(): String
      # processHeaders(headers: String[])
      # mapRowToTree(row: String[], lineNumber: long): TreeRecord
    }
    note bottom of AbstractGeoJsonProvider
      All three base classes abort if 0 trees
      were parsed (transient-failure guard),
      so an empty DB is never published.
    end note

    package austria {
      class ViennaProvider extends AbstractCsvProvider
      class LinzProvider extends AbstractCsvProvider
      class InnsbruckProvider extends AbstractXlsxProvider
      class GrazProvider extends AbstractGeoJsonProvider
    }

    package germany {
      class BerlinProvider extends AbstractGeoJsonProvider
      class HamburgProvider extends AbstractGeoJsonProvider
      class FreiburgProvider extends AbstractGeoJsonProvider
      class DortmundProvider extends AbstractGeoJsonProvider
      class RostockProvider extends AbstractGeoJsonProvider
      class WuerzburgProvider extends AbstractGeoJsonProvider
      class LeipzigProvider extends AbstractGeoJsonProvider
      class FrankfurtProvider extends AbstractCsvProvider
      class KoelnProvider extends AbstractGeoJsonProvider
      class StuttgartProvider extends AbstractGeoJsonProvider
      class GelsenkirchenProvider extends AbstractGeoJsonProvider
      class BonnProvider extends AbstractGeoJsonProvider
    }

    package switzerland {
      class ZurichProvider extends AbstractGeoJsonProvider
      class BaselProvider extends AbstractGeoJsonProvider
      class ZugProvider extends AbstractGeoJsonProvider
    }
  }

  package utils {
    class DatabaseExporter {
      + open()
      + createTable()
      + insertBatch(trees: List<TreeRecord>)
      + insertGeofences(geofences: List<GeofenceRecord>)
      + close()
    }
    class CatalogBuilder {
      + {static} build(outputFile: File, providers: List<CityProvider>, baseUrl: String)
    }
    class CryptoManager {
      + loadOrGenerateKeyPair(privFile: File, pubFile: File)
      + savePublicKey(file: File)
      + signFile(dataFile: File, signatureFile: File)
    }
    class Translator {
      + {static} translateGenus(german: String): String
      + {static} translateSpecies(german: String): String
      + {static} germanGenusFromLatin(botanical: String): String
    }
    class UtmConverter {
      + {static} utm32NToWgs84(easting: double, northing: double): double[]
      + {static} utm33NToWgs84(easting: double, northing: double): double[]
      + {static} utmNorthToWgs84(easting: double, northing: double, zone: int): double[]
    }
    class XlsxReader {
      + {static} read(xlsxStream: InputStream): List<String[]>
    }
  }
}

Main --> CityProvider : iterates (parallel via ExecutorService)
Main --> DatabaseExporter : creates per city
Main --> CryptoManager : loadOrGenerateKeyPair + signFile
Main --> CatalogBuilder : builds catalog.json

AbstractGeoJsonProvider ..> TreeRecord : creates
AbstractCsvProvider ..> TreeRecord : creates
AbstractXlsxProvider ..> TreeRecord : creates
AbstractXlsxProvider ..> XlsxReader : decodes sheet (JDK zip + StAX)

AbstractGeoJsonProvider ..> UtmConverter : uses (e.g. Köln 32N, Leipzig 33N)
AbstractCsvProvider ..> UtmConverter : uses (e.g. Frankfurt 32N)

AbstractGeoJsonProvider ..> Translator : genus/species (incl. germanGenusFromLatin)
AbstractCsvProvider ..> Translator : genus/species
AbstractXlsxProvider ..> Translator : genus/species
@enduml
