@startuml
skinparam backgroundColor #FFFFFF
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName Inter
skinparam roundCorner 12

<style>
root {
  padding 8;
}
</style>

skinparam rectangleFontColor black
skinparam databaseFontColor black
skinparam databaseBackgroundColor #ECEFF1
skinparam databaseBorderColor #546E7A

skinparam rectangle {
  BackgroundColor<<github>> #F3E5F5
  BorderColor<<github>> #7B1FA2
  BackgroundColor<<osm>> #E8F5E9
  BorderColor<<osm>> #4CAF50
  BackgroundColor<<core>> #E3F2FD
  BorderColor<<core>> #1976D2
  BackgroundColor<<web>> #FFF3E0
  BorderColor<<web>> #F57C00
  BackgroundColor<<opt>> #FFFDE7
  BorderColor<<opt>> #F9A825
}

rectangle "📦  GitHub Pages (docs/data)\ncatalog.json · pro Stadt:\n<i>stadt</i>.db.gz + .sig (Bäume/Zonen)\ngeocoder_<i>stadt</i>.jsonl.gz + .sig" as GH <<github>>
rectangle "🌍  Geofabrik\nOSM-Länder-PBFs (DE/AT/CH)" as OSM <<osm>>

rectangle "⚙️  loader (Java 25, Maven)\n· Ed25519-Signaturprüfung (JDK-JCE)\n· idempotent je dataVersion\n· Statistiken global + je Stadt\n· Generalisierung: Stadtpunkte + Rasterzellen" as Loader <<core>>
database "🐘  PostGIS\ntrees · allergy_zones\n(ST_Buffer geography)\ngenus_stats(_city)" as PG
rectangle "🗺️  GeoServer 2.28\nWMS 1.3.0 · WFS 2.0 + CQL\nOGC API Features\nVektorkacheln (MVT via Kachel-Cache)\n(REST-provisioniert)" as GS <<core>>

rectangle "🖥️  web (nginx + Angular 22)\nRenderer umschaltbar: OpenLayers (WMS)\n⇄ MapLibre (Vektorkacheln, Beta)\nsame-origin Proxys:\n/geoserver · /graphhopper · /photon\n<b>einziger LAN-Port (8082)</b>" as Web <<web>>

rectangle "✂️  graph-builder (Profil routing)\nosmium: 19 Stadt-BBoxen + Rand\n→ island.osm.pbf" as GB <<opt>>
rectangle "🧭  GraphHopper 10 (Profil routing)\nfoot + bike, flexibler Modus\nCustom-Model-Zonen je Anfrage" as GHopper <<opt>>
rectangle "📍  Photon 1.2 (Profil geocoding)\nImport der Stadt-Häppchen\nAdress- & POI-Suche, lokal" as Photon <<opt>>

actor "Browser" as User

GH -down-> Loader : Katalog + DBs\n(signiert)
Loader -down-> PG : Import
Loader -right-> GS : REST-Provisionierung\n(Workspace, Layer, Styles)
PG -up-> GS : JDBC
GH -down-> Photon : geocoder_*.jsonl.gz\n(CITY_FILTER)
OSM -down-> GB : PBF (gecacht)
GB -right-> GHopper : island.osm.pbf
GS -down-> Web : WMS/WFS + MVT
GHopper -up-> Web : /route
Photon -up-> Web : /api
User -up-> Web : http://localhost:8082
@enduml
