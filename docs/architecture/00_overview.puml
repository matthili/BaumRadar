@startuml
skinparam backgroundColor transparent
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName Inter
skinparam roundCorner 12

<style>
root {
  padding 8;
}
</style>

' Weiße Linien, Pfeile und Beschriftungen für Dark-Mode-Kompatibilität
skinparam ArrowColor white
skinparam ArrowFontColor white
skinparam actorBorderColor white
skinparam actorFontColor white
skinparam actorBackgroundColor transparent

' Vertikales Layout (top to bottom statt left to right)
top to bottom direction

skinparam rectangle {
  BackgroundColor<<source>> #E8F5E9
  BorderColor<<source>> #4CAF50
  BackgroundColor<<backend>> #E3F2FD
  BorderColor<<backend>> #1976D2
  BackgroundColor<<github>> #F3E5F5
  BorderColor<<github>> #7B1FA2
  BackgroundColor<<app>> #FFF3E0
  BorderColor<<app>> #F57C00
  BackgroundColor<<web>> #FFFDE7
  BorderColor<<web>> #F9A825
}

rectangle "🌐  Open-Data-Quellen\n19 Städte · AT / DE / CH\nBaumkataster-Datensätze" as Src <<source>>

rectangle "⚙️  Java-Backend (Data-Processor)\n· Einlesen & Normalisieren\n· Gattungs-Übersetzung (DE/EN)\n· Räumliches Clustering → Geofences\n· GZIP-Kompression + Chunk-Split\n· Ed25519-Signatur" as BE <<backend>>

rectangle "📦  GitHub Repository\nSignierte SQLite-Datenbanken\n+ catalog.json" as GH <<github>>

rectangle "📱  Android-App (Kotlin / Compose)\n· Signaturprüfung\n· Offline-First (Room DB)\n· OSM-Karte + AR-Kompass-Pfeile\n· Allergiefreies Routing (OSRM)\n· Geofence-Annäherungswarnung" as App <<app>>

rectangle "🖥️  WebGIS-Tech-Demo (Docker)\n· PostGIS + GeoServer (WMS/WFS/OGC API\n  + Vektorkacheln)\n· Angular-Karte, Renderer umschaltbar:\n  OpenLayers (Server-Bilder) ⇄ MapLibre (lokal)\n· lokales Routing + Adresssuche" as Web <<web>>

actor "Nutzer:in\n(Allergie-Profil)" as User

Src -down-> BE : einlesen
BE -down-> GH : publish
GH -down-> App : download\n& verify
GH -down-> Web : download\n& verify
User -right-> App
@enduml