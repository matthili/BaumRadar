@startuml
' Layered view of the WebGIS, anchored in the classic model
' "browser -> web server -> server program -> database".
' Complements 08_webgis_architecture.puml (data-flow view) with the layer view.
skinparam backgroundColor #FFFFFF
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName Inter
skinparam roundCorner 12
skinparam rectangleFontColor black
skinparam databaseFontColor black
skinparam databaseBackgroundColor #FBE9E7
skinparam databaseBorderColor #E64A19

skinparam rectangle {
  BackgroundColor<<band>> #FAFAFA
  BorderColor<<band>> #B0BEC5
  BackgroundColor<<run>> #E0F2F1
  BorderColor<<run>> #00897B
  BackgroundColor<<lib>> #FFFFFF
  BorderColor<<lib>> #78909C
  BackgroundColor<<store>> #FBE9E7
  BorderColor<<store>> #E64A19
  BackgroundColor<<once>> #ECEFF1
  BorderColor<<once>> #546E7A
}

rectangle "Layer 1 · in the browser — “the web page”" as B1 <<band>> {
  rectangle "🖥️  Angular app — the user interface\n(one built bundle of static files)" as APP <<run>> {
    rectangle "🧩  Map library (switchable)\nOpenLayers = server images (default)\nMapLibre = vector tiles in browser" as OL <<lib>>
  }
}

rectangle "Layer 2 · nginx — “the web server” (two hats)" as B2 <<band>> {
  rectangle "📤  Hat 1: web server\nserves the finished app" as HUT1 <<run>>
  rectangle "🔀  Hat 2: reverse proxy\nforwards requests to the services" as HUT2 <<run>>
}

rectangle "Layer 3 · server programs — “the PHP”, as three specialists" as B3 <<band>> {
  rectangle "🗺️  GeoServer\npaints map images (WMS)\ndelivers raw data (WFS)" as GS <<run>>
  rectangle "🧭  GraphHopper\ncomputes routes" as GHOP <<run>>
  rectangle "📍  Photon\nfinds addresses" as PH <<run>>
}

rectangle "Layer 4 · data stores — “the MySQL”" as B4 <<band>> {
  database "🐘  PostGIS = the database\nPostgreSQL + geo extension\ntrees · allergy_zones · statistics" as PG
  rectangle "🕸️  Graph file\nroad network — lives in RAM" as GRAPH <<store>>
  rectangle "🔎  Search index\naddresses — on disk" as IDX <<store>>
}

rectangle "One-shot jobs — “the installer”: fill up, then exit" as B5 <<band>> {
  rectangle "⚙️  loader\nfills PostGIS, sets up GeoServer" as LOADER <<once>>
  rectangle "✂️  graph-builder\nbuilds the graph file from OSM" as GB <<once>>
}

APP -down-> HUT1 : page load
APP -down-> HUT2 : API requests
HUT2 -down-> GS
HUT2 -down-> GHOP
HUT2 -down-> PH
GS -down-> PG : SQL
GHOP -down-> GRAPH
PH -down-> IDX
LOADER .up.> PG : fills once
GB .up.> GRAPH : creates once
@enduml
